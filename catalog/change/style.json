{
  "version": 8,
  "name": "Occurrence change intensity",
  "metadata": {
    "portolan:description": "Occurrence change intensity from the global overview COG, in the Data Users Guide colours. Not water and nodata are transparent. Needs maplibre-cog-protocol for cog:// sources."
  },
  "sources": {
    "basemap": {
      "type": "raster",
      "tileSize": 256,
      "attribution": "Esri, HERE, Garmin, (c) OpenStreetMap contributors",
      "tiles": [
        "https://services.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}"
      ]
    },
    "change": {
      "type": "raster",
      "url": "cog://https://data.source.coop/portolan-mirrors/global-surface-water/change/change-overview.tif",
      "tileSize": 256,
      "attribution": "Source: EC JRC/Google"
    }
  },
  "layers": [
    {
      "id": "basemap",
      "type": "raster",
      "source": "basemap"
    },
    {
      "id": "change",
      "type": "raster",
      "source": "change",
      "paint": {
        "raster-resampling": "nearest"
      }
    }
  ]
}
